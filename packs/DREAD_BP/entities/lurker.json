{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "dread:lurker",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "dread:state": { "type": "enum", "values": [ "observe", "stalk", "hunt", "notice", "retreat" ], "default": "observe", "client_sync": true },
        "dread:action": { "type": "enum", "values": [ "none", "attack", "notice", "hurt", "death" ], "default": "none", "client_sync": true }
      }
    },
    "component_groups": {
      "dread:observe": {
        "minecraft:movement": { "value": 0.0 },
        "minecraft:behavior.look_at_player": { "priority": 1, "look_distance": 64, "target_distance": 64, "probability": 1.0, "angle_of_view_horizontal": 360, "angle_of_view_vertical": 180 }
      },
      "dread:stalk": {
        "minecraft:movement": { "value": 0.11 },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1, "must_see": false, "reselect_targets": true, "within_radius": 48, "scan_interval": 10,
          "entity_types": [ { "filters": { "test": "is_family", "subject": "other", "value": "player" }, "max_dist": 48 } ]
        },
        "minecraft:behavior.move_towards_target": { "priority": 2, "speed_multiplier": 1.0, "within_radius": 9 },
        "minecraft:behavior.look_at_player": { "priority": 3, "look_distance": 64, "target_distance": 64, "probability": 1.0, "angle_of_view_horizontal": 360, "angle_of_view_vertical": 180 }
      },
      "dread:hunt": {
        "minecraft:movement": { "value": 0.34 },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1, "must_see": false, "reselect_targets": true, "within_radius": 40, "scan_interval": 5,
          "entity_types": [ { "filters": { "test": "is_family", "subject": "other", "value": "player" }, "max_dist": 40 } ]
        },
        "minecraft:behavior.melee_attack": {
          "priority": 2, "speed_multiplier": 1.0, "cooldown_time": 1.4, "reach_multiplier": 1.5, "track_target": true,
          "on_attack": { "event": "dread:on_attack", "target": "self" }
        }
      },
      "dread:retreat": {
        "minecraft:movement": { "value": 0.3 },
        "minecraft:behavior.avoid_mob_type": {
          "priority": 1, "max_dist": 24, "max_flee": 40, "walk_speed_multiplier": 1.0, "sprint_speed_multiplier": 1.2,
          "ignore_visibility": true, "entity_types": [ { "filters": { "test": "is_family", "subject": "other", "value": "player" }, "max_dist": 24 } ]
        }
      },
      "dread:dead": { "minecraft:movement": { "value": 0.0 } }
    },
    "components": {
      "minecraft:type_family": { "family": [ "dread", "lurker", "monster" ] },
      "minecraft:health": { "value": 36, "max": 36 },
      "minecraft:collision_box": { "width": 0.6, "height": 2.9 },
      "minecraft:attack": { "damage": 4 },
      "minecraft:knockback_resistance": { "value": 0.4 },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": { "can_path_over_water": false, "avoid_water": true, "avoid_damage_blocks": true, "can_pass_doors": true, "can_open_doors": false, "avoid_sun": false },
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": true },
      "minecraft:follow_range": { "value": 64, "max": 64 },
      "minecraft:damage_sensor": {
        "triggers": [ { "on_damage": { "event": "dread:on_hurt", "target": "self" }, "deals_damage": "yes" } ]
      },
      "minecraft:despawn": { "despawn_from_distance": { "min_distance": 96, "max_distance": 128 } },
      "minecraft:loot": { "table": "loot_tables/entities/dread_lurker.json" },
      "minecraft:experience_reward": { "on_death": "5" },
      "minecraft:nameable": {}
    },
    "events": {
      "minecraft:entity_spawned": { "sequence": [ { "add": { "component_groups": [ "dread:observe" ] } } ] },
      "dread:set_observe": { "remove": { "component_groups": [ "dread:stalk", "dread:hunt", "dread:retreat" ] }, "add": { "component_groups": [ "dread:observe" ] }, "set_property": { "dread:state": "observe" } },
      "dread:set_stalk": { "remove": { "component_groups": [ "dread:observe", "dread:hunt", "dread:retreat" ] }, "add": { "component_groups": [ "dread:stalk" ] }, "set_property": { "dread:state": "stalk" } },
      "dread:set_hunt": { "remove": { "component_groups": [ "dread:observe", "dread:stalk", "dread:retreat" ] }, "add": { "component_groups": [ "dread:hunt" ] }, "set_property": { "dread:state": "hunt" } },
      "dread:set_retreat": { "remove": { "component_groups": [ "dread:observe", "dread:stalk", "dread:hunt" ] }, "add": { "component_groups": [ "dread:retreat" ] }, "set_property": { "dread:state": "retreat" } },
      "dread:on_attack": { "set_property": { "dread:action": "attack" } },
      "dread:on_hurt": { "set_property": { "dread:action": "hurt" } },
      "dread:clear_action": { "set_property": { "dread:action": "none" } },
      "dread:vanish": { "add": { "component_groups": [ "dread:dead" ] } }
    }
  }
}
