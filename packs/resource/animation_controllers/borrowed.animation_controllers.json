{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.hollow.borrowed.form": {
      "initial_state": "disguised",
      "states": {
        "disguised": {
          "animations": [
            "disguise"
          ],
          "transitions": [
            {
              "revealing": "variable.revealed"
            }
          ],
          "blend_transition": 0.15
        },
        "revealing": {
          "animations": [
            "reveal"
          ],
          "transitions": [
            {
              "revealed": "query.all_animations_finished"
            },
            {
              "disguised": "!variable.revealed"
            }
          ]
        },
        "revealed": {
          "animations": [
            "revealed"
          ],
          "transitions": [
            {
              "disguised": "!variable.revealed"
            }
          ],
          "blend_transition": 0.2
        }
      }
    },
    "controller.animation.hollow.borrowed.locomotion": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            {
              "idle": "variable.state != 'revealing'"
            }
          ],
          "transitions": [
            {
              "running": "query.modified_move_speed > 0.06 && variable.revealed && variable.state != 'revealing'"
            },
            {
              "walking": "query.modified_move_speed > 0.06 && !variable.revealed"
            }
          ],
          "blend_transition": 0.2
        },
        "walking": {
          "animations": [
            {
              "walk": "math.clamp(query.modified_move_speed * 5.0, 0.0, 1.0)"
            }
          ],
          "transitions": [
            {
              "idle": "query.modified_move_speed < 0.03 || variable.state == 'revealing'"
            },
            {
              "running": "variable.revealed"
            }
          ],
          "blend_transition": 0.2
        },
        "running": {
          "animations": [
            {
              "run": "math.clamp(query.modified_move_speed * 5.0, 0.0, 1.0)"
            }
          ],
          "transitions": [
            {
              "idle": "query.modified_move_speed < 0.03 || variable.state == 'revealing'"
            },
            {
              "walking": "!variable.revealed"
            }
          ],
          "blend_transition": 0.2
        }
      }
    },
    "controller.animation.hollow.borrowed.strike": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "attacking": "variable.attack_time > 0.0"
            }
          ]
        },
        "attacking": {
          "animations": [
            "attack"
          ],
          "transitions": [
            {
              "default": "query.all_animations_finished"
            }
          ]
        }
      }
    }
  }
}