{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.hollow.hollowed.locomotion": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "walking": "query.modified_move_speed > 0.06"
            }
          ],
          "blend_transition": 0.25
        },
        "walking": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "idle": "query.modified_move_speed < 0.03"
            }
          ],
          "blend_transition": 0.25
        }
      }
    },
    "controller.animation.hollow.hollowed.mood": {
      "initial_state": "calm",
      "states": {
        "calm": {
          "animations": [
            "click"
          ],
          "transitions": [
            {
              "alert": "variable.state == 'investigate'"
            }
          ]
        },
        "alert": {
          "animations": [
            "click",
            "investigate"
          ],
          "transitions": [
            {
              "calm": "variable.state != 'investigate'"
            }
          ],
          "blend_transition": 0.3
        }
      }
    },
    "controller.animation.hollow.hollowed.strike": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "attacking": "variable.attack_time > 0.0"
            }
          ]
        },
        "attacking": {
          "animations": [
            "attack"
          ],
          "transitions": [
            {
              "default": "query.all_animations_finished"
            }
          ]
        }
      }
    }
  }
}