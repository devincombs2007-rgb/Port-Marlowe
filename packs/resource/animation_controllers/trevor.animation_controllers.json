{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.hollow.trevor.locomotion": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "downed": "variable.state == 'downed'"
            },
            {
              "running": "query.modified_move_speed > 0.42"
            },
            {
              "walking": "query.modified_move_speed > 0.06"
            }
          ],
          "blend_transition": 0.3
        },
        "walking": {
          "animations": [
            {
              "walk": "math.clamp(query.modified_move_speed * 5.0, 0.0, 1.0)"
            }
          ],
          "transitions": [
            {
              "downed": "variable.state == 'downed'"
            },
            {
              "running": "query.modified_move_speed > 0.46"
            },
            {
              "idle": "query.modified_move_speed < 0.03"
            }
          ],
          "blend_transition": 0.3
        },
        "running": {
          "animations": [
            "run"
          ],
          "transitions": [
            {
              "downed": "variable.state == 'downed'"
            },
            {
              "walking": "query.modified_move_speed < 0.38"
            }
          ],
          "blend_transition": 0.25
        },
        "downed": {
          "animations": [
            "downed"
          ],
          "transitions": [
            {
              "idle": "variable.state != 'downed'"
            }
          ],
          "blend_transition": 0.5
        }
      }
    },
    "controller.animation.hollow.trevor.combat": {
      "initial_state": "calm",
      "states": {
        "calm": {
          "transitions": [
            {
              "aiming": "query.has_target && variable.state != 'downed'"
            },
            {
              "working": "variable.state == 'work'"
            }
          ]
        },
        "aiming": {
          "animations": [
            "aim"
          ],
          "transitions": [
            {
              "calm": "!query.has_target || variable.state == 'downed'"
            }
          ],
          "blend_transition": 0.2
        },
        "working": {
          "animations": [
            "work"
          ],
          "transitions": [
            {
              "calm": "variable.state != 'work'"
            }
          ],
          "blend_transition": 0.3
        }
      }
    }
  }
}