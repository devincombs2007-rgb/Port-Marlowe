{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.hollow.watcher.locomotion": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "walking": "query.modified_move_speed > 0.08 && !variable.patient"
            },
            {
              "creeping": "query.modified_move_speed > 0.05 && variable.patient"
            }
          ],
          "blend_transition": 0.3
        },
        "walking": {
          "animations": [
            {
              "walk": "math.clamp(query.modified_move_speed * 5.0, 0.0, 1.0)"
            }
          ],
          "transitions": [
            {
              "idle": "query.modified_move_speed < 0.04"
            },
            {
              "creeping": "variable.patient"
            }
          ],
          "blend_transition": 0.3
        },
        "creeping": {
          "animations": [
            {
              "creep": "math.clamp(query.modified_move_speed * 7.0, 0.0, 1.0)"
            }
          ],
          "transitions": [
            {
              "idle": "query.modified_move_speed < 0.03"
            },
            {
              "walking": "!variable.patient"
            }
          ],
          "blend_transition": 0.45
        }
      }
    },
    "controller.animation.hollow.watcher.mood": {
      "initial_state": "neutral",
      "states": {
        "neutral": {
          "transitions": [
            {
              "lurk": "variable.state == 'lurk'"
            },
            {
              "seen": "variable.state == 'withdraw'"
            },
            {
              "lunge": "variable.state == 'lunge'"
            }
          ]
        },
        "lurk": {
          "animations": [
            "stare"
          ],
          "transitions": [
            {
              "neutral": "variable.state != 'lurk'"
            }
          ],
          "blend_transition": 0.4
        },
        "seen": {
          "animations": [
            "seen"
          ],
          "transitions": [
            {
              "neutral": "variable.state != 'withdraw'"
            }
          ],
          "blend_transition": 0.05
        },
        "lunge": {
          "animations": [
            "lunge"
          ],
          "transitions": [
            {
              "neutral": "variable.state != 'lunge'"
            }
          ],
          "blend_transition": 0.1
        }
      }
    }
  }
}