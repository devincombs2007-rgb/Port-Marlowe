{
  "format_version": "1.8.0",
  "animations": {
    "animation.hollow.bomber.props": {
      "loop": true,
      "bones": {
        "prop0": {
          "rotation": [
            0,
            0,
            "query.life_time * 1500"
          ]
        },
        "prop1": {
          "rotation": [
            0,
            0,
            "query.life_time * 1537"
          ]
        },
        "prop2": {
          "rotation": [
            0,
            0,
            "query.life_time * 1574"
          ]
        },
        "prop3": {
          "rotation": [
            0,
            0,
            "query.life_time * 1611"
          ]
        }
      }
    },
    "animation.hollow.bomber.doors": {
      "loop": true,
      "bones": {
        "door_l": {
          "rotation": [
            0,
            0,
            "query.property('hollow:open') ? -80 : 0"
          ]
        },
        "door_r": {
          "rotation": [
            0,
            0,
            "query.property('hollow:open') ? 80 : 0"
          ]
        }
      }
    },
    "animation.hollow.bomb.wobble": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [
            "math.sin(query.life_time * 400 + 0) * 2",
            "math.sin(query.life_time * 330 + 40) * 2",
            "query.life_time * 30"
          ]
        }
      }
    },
    "animation.hollow.helicopter.rotors": {
      "loop": true,
      "bones": {
        "rotor": {
          "rotation": [
            0,
            "query.life_time * 1300",
            0
          ]
        },
        "tail_rotor": {
          "rotation": [
            "query.life_time * 2600",
            0,
            0
          ]
        },
        "body": {
          "rotation": [
            6,
            0,
            0
          ]
        }
      }
    },
    "animation.hollow.mushroom_cloud.bloom": {
      "loop": true,
      "bones": {
        "root": {
          "scale": 40
        },
        "fireball": {
          "position": [
            0,
            "math.min(9, math.max(0, query.life_time - 1.0)) * 2.2",
            0
          ],
          "scale": "query.life_time < 0.5 ? 0.3 + query.life_time * 1.4 : (query.life_time < 7 ? 1.0 + (query.life_time - 0.5) * 0.05 : math.max(0, 1.33 - (query.life_time - 7) * 0.4))"
        },
        "cap": {
          "position": [
            0,
            "-22 + math.min(22, math.max(0, query.life_time - 1.5) * 1.55)",
            0
          ],
          "scale": "query.life_time < 1.5 ? 0 : math.min(1, 0.3 + (query.life_time - 1.5) * 0.055)",
          "rotation": [
            0,
            "query.life_time * 1.5",
            0
          ]
        },
        "stem": {
          "scale": [
            "query.life_time < 2 ? 0 : math.clamp(0.3 + (query.life_time - 2) * 0.06, 0.3, 1)",
            "math.clamp((query.life_time - 2) / 14, 0, 1)",
            "query.life_time < 2 ? 0 : math.clamp(0.3 + (query.life_time - 2) * 0.06, 0.3, 1)"
          ]
        },
        "skirt": {
          "position": [
            0,
            "math.max(0, query.life_time - 2.5) * 1.2",
            0
          ],
          "scale": "(query.life_time > 2.5 && query.life_time < 9) ? 0.6 + (query.life_time - 2.5) * 0.12 : 0"
        },
        "surge": {
          "scale": [
            "query.life_time < 2 ? 0 : math.min(2.4, 0.4 + (query.life_time - 2) * 0.16)",
            "query.life_time < 2 ? 0 : math.min(1.2, 0.4 + (query.life_time - 2) * 0.1)",
            "query.life_time < 2 ? 0 : math.min(2.4, 0.4 + (query.life_time - 2) * 0.16)"
          ]
        },
        "shock": {
          "scale": [
            "(query.life_time > 0.3 && query.life_time < 6.5) ? 0.15 + (query.life_time - 0.3) * 0.55 : 0",
            1,
            "(query.life_time > 0.3 && query.life_time < 6.5) ? 0.15 + (query.life_time - 0.3) * 0.55 : 0"
          ]
        }
      }
    }
  }
}