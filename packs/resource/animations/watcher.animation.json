        "left_arm": { "rotation": ["math.sin(query.anim_time * 48 + 90) * 2.5", 0, "-math.sin(query.anim_time * 30) * 1.5"] },
        "right_hand": { "rotation": ["math.sin(query.anim_time * 90) * 4", 0, 0] },
        "left_hand": { "rotation": ["math.sin(query.anim_time * 90 + 120) * 4", 0, 0] }
