{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "hollow:faithful",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/hollow/faithful"
      },
      "geometry": {
        "default": "geometry.hollow.faithful"
      },
      "animations": {
        "idle": "animation.hollow.cult.idle",
        "walk": "animation.hollow.cult.walk",
        "run": "animation.hollow.cult.run",
        "look_at_target": "animation.hollow.cult.look_at_target",
        "locomotion": "controller.animation.hollow.cult.locomotion",
        "tend": "animation.hollow.cult.tend"
      },
      "scripts": {
        "animate": [
          "look_at_target",
          "locomotion",
          {
            "tend": "query.modified_move_speed < 0.02 && math.mod(query.life_time + query.position(0), 30.0) < 9.0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.hollow.default"
      ],
      "spawn_egg": {
        "base_color": "#c4c0b0",
        "overlay_color": "#b8622c"
      }
    }
  }
}