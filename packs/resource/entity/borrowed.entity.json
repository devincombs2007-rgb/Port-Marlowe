        "idle": "animation.hollow.borrowed.idle",
        "walk": "animation.hollow.borrowed.walk",
        "look_at_target": "animation.hollow.borrowed.look_at_target",
        "reveal": "animation.hollow.borrowed.reveal",
        "revealed": "animation.hollow.borrowed.revealed",
        "attack": "animation.hollow.borrowed.attack",
        "form": "controller.animation.hollow.borrowed.form",
