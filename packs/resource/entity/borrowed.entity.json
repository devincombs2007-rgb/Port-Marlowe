        "strike": "controller.animation.hollow.borrowed.strike",
        "run": "animation.hollow.borrowed.run"
      },
      "scripts": {
        "pre_animation": [
          "variable.night = query.time_of_day < 0.23 || query.time_of_day > 0.77;",
