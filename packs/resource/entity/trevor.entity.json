        "run": "animation.hollow.trevor.run",
        "aim": "animation.hollow.trevor.aim",
        "downed": "animation.hollow.trevor.downed",
        "work": "animation.hollow.trevor.work",
        "look_at_target": "animation.hollow.trevor.look_at_target",
