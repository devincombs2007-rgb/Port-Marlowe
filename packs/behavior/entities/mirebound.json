{
  "format_version": "1.26.50",
  "minecraft:entity": {
    "description": {
      "identifier": "hollow:mirebound",
      "is_spawnable": true,
      "is_summonable": true,
      "spawn_category": "monster",
      "properties": {
        "hollow:state": {
          "type": "enum",
          "values": ["lurk", "erupt", "grab", "retreat"],
          "default": "lurk",
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "hollow:lurk": {
        "minecraft:behavior.look_at_player": {
          "priority": 6,
          "look_distance": 10,
          "probability": 0.2,
          "look_time": { "min": 2, "max": 4 }
        }
      },
      "hollow:erupt": {
        "minecraft:behavior.look_at_player": {
          "priority": 1,
          "look_distance": 8,
          "probability": 1.0,
          "look_time": { "min": 2, "max": 2 }
        }
      },
      "hollow:grab": {
        "minecraft:rideable": {
          "seat_count": 1,
          "family_types": ["player"],
          "interact_text": "",
          "crouching_skip_interact": true,
          "pull_in_entities": false,
          "dismount_mode": "default",
          "seats": [{ "position": [0.0, 0.15, -1.15] }],
          "on_rider_exit_event": "hollow:rider_left"
        }
      },
      "hollow:retreat": {
        "minecraft:behavior.avoid_mob_type": {
          "priority": 1,
          "max_dist": 24,
          "max_flee": 24,
          "sprint_distance": 8,
          "walk_speed_multiplier": 1.4,
          "sprint_speed_multiplier": 1.8,
          "ignore_visibility": true,
          "remove_target": true,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "player" },
              "max_dist": 24
            }
          ]
        },
        "minecraft:behavior.random_swim": {
          "priority": 3,
          "speed_multiplier": 1.2,
          "xz_dist": 10,
          "y_dist": 3
        }
      },
      "hollow:despawn": {
        "minecraft:instant_despawn": {}
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["hollow", "hollow_creature", "mirebound", "monster", "mob"]
      },
      "minecraft:health": { "value": 30, "max": 30 },
      "minecraft:attack": { "damage": 4 },
      "minecraft:movement": { "value": 0.12 },
      "minecraft:underwater_movement": { "value": 0.08 },
      "minecraft:movement.amphibious": { "max_turn": 15 },
      "minecraft:navigation.generic": {
        "is_amphibious": true,
        "can_swim": true,
        "can_walk": true,
        "can_sink": true,
        "avoid_damage_blocks": true
      },
      "minecraft:jump.static": {},
      "minecraft:collision_box": { "width": 1.3, "height": 0.7 },
      "minecraft:physics": {},
      "minecraft:pushable_by_block": {},
      "minecraft:knockback_resistance": { "value": 0.7 },
      "minecraft:breathable": { "breathes_water": true, "breathes_air": true, "total_supply": 15, "suffocate_time": 0 },
      "minecraft:nameable": {},
      "minecraft:loot": { "table": "loot_tables/hollow/entities/mirebound.json" },
      "minecraft:experience_reward": { "on_death": "query.last_hit_by_player ? 10 : 0" },
      "minecraft:despawn": {
        "despawn_from_distance": { "min_distance": 64, "max_distance": 96 }
      },
      "minecraft:ambient_sound_interval": {
        "value": 7,
        "range": 8,
        "event_name": "ambient"
      },
      "minecraft:conditional_bandwidth_optimization": {}
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["hollow:lurk"] },
        "set_property": { "hollow:state": "lurk" }
      },
      "hollow:erupt": {
        "remove": { "component_groups": ["hollow:lurk", "hollow:retreat", "hollow:grab"] },
        "add": { "component_groups": ["hollow:erupt"] },
        "set_property": { "hollow:state": "erupt" }
      },
      "hollow:grab": {
        "remove": { "component_groups": ["hollow:lurk", "hollow:erupt", "hollow:retreat"] },
        "add": { "component_groups": ["hollow:grab"] },
        "set_property": { "hollow:state": "grab" }
      },
      "hollow:retreat": {
        "remove": { "component_groups": ["hollow:lurk", "hollow:erupt", "hollow:grab"] },
        "add": { "component_groups": ["hollow:retreat"] },
        "set_property": { "hollow:state": "retreat" }
      },
      "hollow:lurk": {
        "remove": { "component_groups": ["hollow:erupt", "hollow:grab", "hollow:retreat"] },
        "add": { "component_groups": ["hollow:lurk"] },
        "set_property": { "hollow:state": "lurk" }
      },
      "hollow:rider_left": {
        "remove": { "component_groups": ["hollow:lurk", "hollow:erupt", "hollow:grab"] },
        "add": { "component_groups": ["hollow:retreat"] },
        "set_property": { "hollow:state": "retreat" }
      },
      "hollow:despawn": {
        "add": { "component_groups": ["hollow:despawn"] }
      }
    }
  }
}
