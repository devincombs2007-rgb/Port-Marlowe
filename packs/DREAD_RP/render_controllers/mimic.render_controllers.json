{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.dread.mimic": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "true_form": "query.property('dread:form') != 'disguise'"
        }
      ]
    }
  }
}
