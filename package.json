{
  "name": "dread-addon",
  "version": "0.2.1",
  "private": true,
  "description": "DREAD - Something Is Watching. Minecraft Bedrock horror add-on.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:scripts": "node tools/build-scripts.mjs",
    "validate": "node tools/validate.mjs",
    "package": "node tools/package.mjs",
    "check": "npm run typecheck && npm run build:scripts && npm run test && npm run validate",
    "release": "npm run check && npm run package",
    "test": "node tests/smoke.mjs && node tools/run-ts-tests.mjs",
    "build:audio": "python3 tools/synth/build_audio.py",
    "assets": "python3 tools/assets/build_assets.py && python3 tools/synth/build_audio.py"
  },
  "devDependencies": {
    "@minecraft/bedrock-schemas": "1.26.50",
    "@minecraft/server": "2.0.0",
    "ajv": "^8.17.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "typescript": "^5.9.0"
  }
}
