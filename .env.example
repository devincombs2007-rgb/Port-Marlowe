# Copy to .env (git-ignored). Only needed for --live; dry-run uses public data.
# Create a key at kalshi.com -> Account & security -> API keys. Kalshi shows the
# private key once: save it as a .pem file outside this repo.
KALSHI_API_KEY_ID=your-key-id
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi-private-key.pem
