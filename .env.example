# Copy to .env (git-ignored).

# ---- Mode -------------------------------------------------------------------
# Used by docker-compose. Empty = paper trading. "--live --yes" = real money.
BOT_ARGS=

# ---- Kalshi API key (only needed for live trading) --------------------------
# kalshi.com -> Account & security -> API keys -> Create. Kalshi shows the private
# key once: save it. With Docker, put it at secrets/kalshi.pem (docker-compose
# mounts it). Without Docker, point KALSHI_PRIVATE_KEY_PATH at the file.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi.pem

# ---- Notifications (set any; all configured channels get every message) -----
# ntfy (easiest): install the free "ntfy" app, subscribe to a long random topic
# name nobody will guess, and put the same name here.
NTFY_TOPIC=
# Telegram: create a bot with @BotFather, message it once, then get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: Server settings -> Integrations -> Webhooks -> New webhook -> Copy URL.
DISCORD_WEBHOOK_URL=
