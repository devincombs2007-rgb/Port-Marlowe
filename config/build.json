{
  "target_engine_version": [1, 26, 50],
  "target_platform": {
    "name": "Xbox Series X",
    "memory_performance_tier": 4,
    "texture_budget_mb": {
      "1": { "resource_pack": 300, "world": 750 },
      "2": { "resource_pack": 450, "world": 1000 },
      "3": { "resource_pack": 600, "world": 1500 },
      "4": { "resource_pack": 1200, "world": 3000 },
      "5": { "resource_pack": 1600, "world": 4000 }
    },
    "tier_platforms": {
      "1": "Nintendo Switch",
      "2": "Xbox One / One S, PS4",
      "3": "Xbox One X, Xbox Series S",
      "4": "Xbox Series X, PS5",
      "5": "PS5 Pro, most PCs"
    }
  },
  "fauna_budget": {
    "max_texture_edge": 512,
    "max_cubes_per_geometry": 160
  },
  "default_profile": "xbox",
  "vanilla_samples": {
    "url": "https://github.com/Mojang/bedrock-samples",
    "ref": "v1.26.50.4",
    "path": ".cache/bedrock-samples"
  },
  "packs": {
    "pm_fauna": { "source": "packs/pm_fauna", "assets": "assets/pm_fauna", "folder": "pm_fauna" },
    "pm_audio": { "source": "packs/pm_audio", "assets": "assets/pm_audio", "folder": "pm_audio" },
    "pm_atmos": { "source": "packs/pm_atmos", "assets": "assets/pm_atmos", "folder": "pm_atmos" }
  },
  "vendor_packs": {
    "vibrant_normals": { "source": "vendor/vibrant_normals", "folder": "vnd_vvn" },
    "vanilla_vibrant_visuals": {
      "source": "vendor/vanilla_vibrant_visuals",
      "folder": "vnd_vvv",
      "subpack": "a",
      "flatten_subpack": true,
      "credit": "Cubeir (github.com/vanilla-rtx/Vanilla-PBR)",
      "credit_authors": ["Cubeir"],
      "license_url": "https://github.com/Cubeir/Vanilla-RTX/blob/master/LICENSE.txt",
      "url": "https://github.com/vanilla-rtx/Vanilla-PBR"
    },
    "vanilla_rtx_opus": { "source": "vendor/vanilla_rtx_opus", "folder": "vnd_vrtx" }
  },
  "profiles": {
    "xbox": {
      "description": "Xbox Series X: Vibrant Visuals, hand-drawn block normals + Vanilla VV lighting-only subpack",
      "stack": ["pm_fauna", "pm_audio", "pm_atmos", "vibrant_normals", "vanilla_vibrant_visuals:b"]
    },
    "vibrant": {
      "description": "Vibrant Visuals with the full Vanilla Vibrant Visuals pack (textures + lighting)",
      "stack": ["pm_fauna", "pm_audio", "pm_atmos", "vanilla_vibrant_visuals:a"]
    },
    "hybrid": {
      "description": "PC guests only: RTX on Windows DXR GPUs; Xbox falls back to Vibrant Visuals with RTX-tuned blocks",
      "stack": ["pm_fauna", "pm_audio", "pm_atmos", "vanilla_rtx_opus"]
    }
  },
  "fauna_material_mode": "mers",
  "sound_fallbacks": {
    "pm.calf.say": { "sound": "mob.cow.say" },
    "pm.calf.hurt": { "sound": "mob.cow.hurt" },
    "pm.lamb.say": { "sound": "mob.sheep.say" },
    "pm.sheep.hurt": { "sound": "mob.sheep.say" },
    "pm.pig.hurt": "mob.pig.say",
    "pm.chicken.plop_thud": "mob.chicken.plop"
  }
}
